{
  "name": "personal-finance-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build:api": "npm run build --workspace api",
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "build": "npm run build --workspace api && npm run build --workspace web",
    "start": "npm run start --workspace api",
    "lint": "npm run lint --workspace web",
    "check": "npm run check --workspace api && npm run check --workspace web"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
